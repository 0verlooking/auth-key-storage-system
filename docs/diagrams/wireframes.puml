@startuml wireframes
!theme blueprint
title Wireframes - Auth Key Storage System

'=========================================
' Login Page
'=========================================
salt "1. Login Page" {
  {+
    {/ <b>Auth Key Storage System</b> | }
    {
      .
      "   "
      {
        <b>Вхід до системи</b>
        .
        Username / Email
        ^username@example.com^
        .
        Password
        ^**********^
        .
        [X] Remember me
        .
        [ Login ]
        .
        <&account-login> Forgot password? | <&account-login> Register
      }
      "   "
      .
    }
  }
}

