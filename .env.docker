# ============================================================================
# Docker Environment Configuration
# Auth Key Storage System
# ============================================================================
# Цей файл містить змінні оточення для Docker Compose
#
# ВАЖЛИВО:
# - НЕ комітьте цей файл з реальними паролями до Git!
# - Для production створіть окремий .env файл з безпечними значеннями
# - Змініть всі паролі перед розгортанням в production
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Spring Profile (docker, dev, prod)
SPRING_PROFILES_ACTIVE=docker

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# PostgreSQL Database
POSTGRES_DB=auth_storage_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_password_change_me

# PostgreSQL Port (external)
POSTGRES_PORT=5432

# JPA/Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis Password
REDIS_PASSWORD=redis_password_change_me

# Redis Port (external)
REDIS_PORT=6379

# ============================================================================
# JWT CONFIGURATION
# ============================================================================

# JWT Secret Key (ВАЖЛИВО: Змініть в production!)
# Має бути мінімум 256 біт (32 символи)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-256-bits-long-for-security

# JWT Token Expiration (в мілісекундах)
# 86400000 ms = 24 години
JWT_EXPIRATION=86400000

# JWT Refresh Token Expiration (в мілісекундах)
# 604800000 ms = 7 днів
JWT_REFRESH_EXPIRATION=604800000

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Backend Port (external)
BACKEND_PORT=8080

# CORS Allowed Origins (розділені комами)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Java Options
JAVA_OPTS=-Xms512m -Xmx1024m

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend Port (external)
FRONTEND_PORT=80

# Vite Build Variables
VITE_API_BASE_URL=/api
VITE_APP_TITLE=Auth Key Storage System
VITE_APP_VERSION=1.0.0

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# SMTP Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Email From Address
MAIL_FROM=noreply@authstorage.local

# ============================================================================
# PGADMIN CONFIGURATION (Development Only)
# ============================================================================

# PgAdmin Credentials
PGADMIN_EMAIL=admin@authstorage.local
PGADMIN_PASSWORD=admin

# PgAdmin Port (external)
PGADMIN_PORT=5050

# ============================================================================
# DOCKER COMPOSE SETTINGS
# ============================================================================

# Compose Project Name
COMPOSE_PROJECT_NAME=auth-key-storage

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# Для production створіть файл .env.production з наступними змінами:
#
# SPRING_PROFILES_ACTIVE=prod
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# LOG_LEVEL_ROOT=WARN
# LOG_LEVEL_APP=INFO
#
# І використовуйте сильні паролі:
# - POSTGRES_PASSWORD=<strong-random-password>
# - REDIS_PASSWORD=<strong-random-password>
# - JWT_SECRET=<strong-random-secret-at-least-256-bits>
# ============================================================================

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Змініть всі паролі перед production deployment
# 2. Використовуйте environment-specific .env файли (.env.dev, .env.prod)
# 3. Ніколи не комітьте реальні паролі до Git
# 4. Розгляньте використання Docker Secrets для production
# 5. JWT_SECRET має бути криптографічно безпечним рядком
# 6. Регулярно оновлюйте паролі та секрети
# ============================================================================

# ============================================================================
# USAGE
# ============================================================================
# Development:
#   cp .env.docker .env
#   docker-compose up -d
#
# Production:
#   cp .env.docker .env.production
#   # Змініть всі паролі в .env.production
#   docker-compose --env-file .env.production up -d
# ============================================================================
